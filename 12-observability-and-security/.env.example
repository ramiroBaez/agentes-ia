# Copy this to .env and change the values. docker compose reads it by itself.
#
#   cp .env.example .env
#
# The session secret is the most important one: with the development default,
# anybody who knows the repo can sign their own cookie and get in as anyone.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET=

# The provider chain, in order of preference: model.py moves to the next one if
# one fails (quota, network, auth). Create free keys at:
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional. Without this, the quota is counted in the memory of the process.
# REDIS_URL=redis://redis:6379/0

# Where the database lives. Inside docker compose it is the /data volume.
#
# Careful when running the CLI on your machine: if you leave a container path
# here, `python -m cli key` writes to a different database from the container's
# and the key it prints will not work. Without Docker use a local path:
# DB_PATH=./agent.db

# The notes for the RAG (semantic search). By default the project finds the
# shared `04-sistema-rag/notas` folder of this repository. Only set this to
# point somewhere else:
# NOTES_DIR=/path/to/your/notes

# Where the embeddings index lives. In the compose file it goes to the volume,
# so it is not re-indexed on every build. Locally, leave it empty (./chroma_db).
# CHROMA_DIR=/data/chroma_db

# Networks or IPs from which X-Forwarded-For is trusted. Only nginx (the proxy of
# this deployment) should be in here: if you publish port 8000 directly, put
# only the real IP of your proxy, because anybody can send that header.
TRUSTED_PROXIES=["127.0.0.1","::1","172.16.0.0/12","10.0.0.0/8","192.168.0.0/16"]

# The origin the browser sends. In compose it is the same nginx.
CORS_ORIGINS=["http://localhost:8080"]
