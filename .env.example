# Create a free API key at:
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
#
# Copy this file to .env and fill in the keys you want to use.
# .env is git-ignored — never commit real keys.
#
# PROVIDERS is a comma-separated FAILOVER CHAIN: providers are tried in order;
# if one fails (429 quota, network, auth), the next one takes over.
# Leave only one for a single-provider setup.
PROVIDERS=gemini,groq,openrouter

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: use ":free" models so you never spend credits.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-27b:free