# Creá una API key gratuita en:
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
#
# Copiá este archivo a .env y completá las keys que quieras usar.
# .env está en .gitignore — nunca comitees keys reales.
#
# PROVIDERS es una CADENA DE RESPALDO separada por comas: se prueban en orden;
# si uno falla (cuota 429, red, auth), toma el control el siguiente.
# Dejá uno solo para un setup de un único proveedor.
PROVIDERS=gemini,groq,openrouter

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: usá modelos ":free" para no gastar crédito nunca.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-27b:free