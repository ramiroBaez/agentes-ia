# Copia este archivo a `.env` y ajustá los valores si querés cambiar de proveedor.
# IMPORTANTE: la API key NO va en este archivo. Se configura UNA vez como
# credencial "Header Auth" (Authorization: Bearer <tu-key>) en el nodo LLM, vía la UI de n8n.
#
# Proveedor usado por defecto: Groq (compatible con la API de OpenAI).
# Para usar OpenRouter, cambiá:
#   LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
#   LLM_MODEL=qwen/qwen3-8b:free
#
# Docker Compose ya define estos valores con defaults, así que n8n funciona
# incluso sin este archivo.

LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b
LLM_SYSTEM_PROMPT=Eres un asistente experto en clasificar y resumir consultas de clientes.